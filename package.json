{
  "name": "neon-racer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Neon-Racer: race against the clock on procedurally generated roads through a neon world, driven with a gamepad.",
  "scripts": {
    "dev": "vite --port 5270 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5271 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
